.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding-top: 10rpx;
}

.tab-bar-item:nth-child(2) {
  margin-right: 76rpx;
}

.tab-bar-item:nth-child(3) {
  margin-left: 76rpx;
}

.tab-bar-center {
  position: absolute;
  left: 50%;
  top: -18rpx;
  transform: translateX(-50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #ff3b61, #ff6a3d);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(255, 74, 105, 0.38);
}

.tab-bar-center-plus {
  color: #FFFFFF;
  font-size: 64rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.tab-bar-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 6rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #7A7A7A;
}

.tab-bar-text.active {
  color: #E8713A;
  font-weight: 600;
}

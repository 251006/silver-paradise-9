<view class="identity-page">
  <!-- 装饰背景元素 -->
  <view class="bg-decoration">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
    <view class="bg-circle bg-circle-3"></view>
  </view>

  <!-- 欢迎区域 -->
  <view class="welcome-header">
    <text class="welcome-title">银龄乐园</text>
    <text class="welcome-subtitle">温暖相伴，岁月静好</text>
    <text class="welcome-hint">请选择您的身份，开启美好时光</text>
  </view>

  <!-- 身份选择卡片 -->
  <view class="role-cards">
    <view
      class="role-card {{selectedRole === 'elder' ? 'role-card-selected' : ''}}"
      bindtap="selectRole"
      data-role="elder"
    >
      <view class="role-icon-wrapper">
        <text class="role-icon">👴🏻</text>
        <view class="role-icon-bg"></view>
      </view>
      <view class="role-content">
        <text class="role-name">我是长辈</text>
        <text class="role-desc">分享智慧、回答问题、记录珍贵回忆</text>
      </view>
      <view class="role-check {{selectedRole === 'elder' ? 'role-check-active' : ''}}">
        <text class="check-icon">✓</text>
      </view>
    </view>

    <view
      class="role-card {{selectedRole === 'young' ? 'role-card-selected' : ''}}"
      bindtap="selectRole"
      data-role="young"
    >
      <view class="role-icon-wrapper">
        <text class="role-icon">👧🏻</text>
        <view class="role-icon-bg"></view>
      </view>
      <view class="role-content">
        <text class="role-name">我是年轻人</text>
        <text class="role-desc">向长辈请教、聆听人生故事</text>
      </view>
      <view class="role-check {{selectedRole === 'young' ? 'role-check-active' : ''}}">
        <text class="check-icon">✓</text>
      </view>
    </view>
  </view>

  <!-- 个人信息区域 -->
  <view class="info-section">
    <!-- 头像选择 -->
    <view class="avatar-section">
      <button
        class="avatar-wrapper"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image class="avatar-image" src="{{avatarUrl}}"></image>
      </button>
      <text class="avatar-hint">点击换头像</text>
    </view>

    <!-- 昵称输入 -->
    <view class="nickname-section">
      <view class="nickname-input-wrapper">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="输入您的昵称"
          maxlength="12"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      <text class="nickname-hint">最多12个字</text>
    </view>
  </view>

  <!-- 进入按钮 -->
  <view class="btn-wrapper">
    <button
      class="enter-btn {{selectedRole && nickname && avatarUrl ? 'enter-btn-active' : ''}}"
      bindtap="onEnter"
      disabled="{{submitting}}"
    >
      <text class="btn-icon">{{submitting ? '⏳' : '🚀'}}</text>
      <text class="btn-text">{{submitting ? '正在登录...' : '开启美好时光'}}</text>
    </button>
    <text class="btn-hint">使用微信账号安全登录</text>
  </view>

</view>

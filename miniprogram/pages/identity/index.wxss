.identity-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 60rpx;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFFFF 100%);
  box-sizing: border-box;
}

.welcome-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.welcome-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #E8713A;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  display: block;
  font-size: 32rpx;
  color: #666666;
}

/* 身份选择卡片 */
.role-cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.role-card {
  background: #FFFFFF;
  border: 4rpx solid #E8E8E8;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.role-card-selected {
  border-color: #E8713A;
  background: #FFF8F0;
  box-shadow: 0 4rpx 24rpx rgba(232, 113, 58, 0.2);
}

.role-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 28rpx;
  color: #999999;
}

.role-card-selected .role-name {
  color: #E8713A;
}

.role-card-selected .role-desc {
  color: #C85A20;
}

/* 头像选择 */
.avatar-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #F5F5F5;
  border: 4rpx solid #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  margin: 0;
  transition: all 0.2s;
}

.avatar-wrapper:active {
  background: #EFEFEF;
  border-color: #E8713A;
  transform: scale(0.95);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-hint {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 昵称输入 */
.nickname-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.nickname-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 100rpx;
  padding: 0 32rpx;
  font-size: 34rpx;
  border: 4rpx solid #E8E8E8;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.nickname-input:focus {
  border-color: #E8713A;
}

/* 进入按钮 */
.enter-btn {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #CCCCCC;
  border-radius: 20rpx;
  border: none;
  letter-spacing: 4rpx;
}

.enter-btn-active {
  background: linear-gradient(135deg, #E8713A, #F5A623);
  box-shadow: 0 8rpx 24rpx rgba(232, 113, 58, 0.4);
}

.enter-btn-active:active {
  opacity: 0.85;
}

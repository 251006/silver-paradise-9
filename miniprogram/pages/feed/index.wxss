/* pages/feed/index.wxss */
.feed-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.feed-header {
  margin-bottom: 32rpx;
}

.feed-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.feed-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

.feed-card {
  margin-bottom: 24rpx;
}

.feed-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8713A, #F5A623);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.feed-avatar-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.feed-avatar-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.feed-author-info {
  margin-left: 20rpx;
}

.feed-author-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.feed-time {
  display: block;
  font-size: 24rpx;
  color: #CCCCCC;
  margin-top: 4rpx;
}

.feed-content {
  display: block;
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.feed-card-footer {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.like-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #FFF8F0;
}

.like-btn:active {
  background: #FFE8D0;
}

.like-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.like-count {
  font-size: 28rpx;
  color: #E8713A;
  font-weight: 500;
}

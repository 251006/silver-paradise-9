<view class="qa-page safe-bottom">
  <view class="qa-header">
    <text class="qa-title">社区问答</text>
    <text class="qa-subtitle">
      {{role === 'elder' ? '用您的经验，帮助年轻人解答困惑' : '向长辈请教人生经验与智慧'}}
    </text>
  </view>

  <view wx:if="{{loading && questions.length === 0}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{questions.length === 0}}" class="empty-state">
    <text class="empty-state-text">暂无问题，快来提问吧</text>
  </view>

  <block wx:else>
    <view
      wx:for="{{questions}}"
      wx:key="_id"
      class="qa-card card"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <view class="qa-card-top">
        <text class="qa-question-title">{{item.title}}</text>
      </view>
      <view wx:if="{{item.content}}" class="qa-question-desc">
        <text>{{item.content}}</text>
      </view>
      <view class="qa-card-bottom">
        <text class="qa-author">{{item.authorName}} 提问</text>
        <view class="qa-answer-count">
          <text class="qa-answer-icon">💬</text>
          <text class="qa-answer-num">{{item.answerCount || 0}} 个回答</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-box">
      <text class="loading-text">加载更多...</text>
    </view>
    <view wx:elif="{{!hasMore}}" class="loading-box">
      <text class="loading-text">没有更多了</text>
    </view>
  </block>

  <!-- 年轻用户的提问按钮 -->
  <view wx:if="{{role === 'young'}}" class="fab" bindtap="goAsk">
    <text class="fab-text">提问</text>
  </view>
</view>

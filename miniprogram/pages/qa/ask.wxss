/* pages/qa/ask.wxss */
.ask-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.ask-header {
  margin-bottom: 24rpx;
}

.ask-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.ask-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 14rpx;
}

.ask-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.form-group {
  margin-bottom: 18rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.count-text {
  font-size: 22rpx;
  color: #AAAAAA;
}

.required {
  color: #FF4D4F;
}

.form-input {
  height: 96rpx;
  font-size: 32rpx;
}

.form-textarea {
  min-height: 240rpx;
  font-size: 32rpx;
}

.submit-btn {
  margin-top: 36rpx;
}

.submit-btn[disabled] {
  background: #CCCCCC !important;
  opacity: 0.6;
}

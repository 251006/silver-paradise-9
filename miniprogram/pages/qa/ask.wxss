/* pages/qa/ask.wxss */
.ask-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.ask-header {
  margin-bottom: 24rpx;
}

.ask-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.ask-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 14rpx;
}

.ask-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.form-group {
  margin-bottom: 18rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.count-text {
  font-size: 22rpx;
  color: #AAAAAA;
}

.required {
  color: #FF4D4F;
}

.form-input {
  height: 96rpx;
  font-size: 32rpx;
}

.form-textarea {
  min-height: 240rpx;
  font-size: 32rpx;
}

.submit-btn {
  margin-top: 36rpx;
}

.submit-btn[disabled] {
  background: #CCCCCC !important;
  opacity: 0.6;
}

/* 图片上传区样式 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.image-item {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F5F5;
}

/* 只有一张图片时显示大图 */
.image-grid .image-item:first-child:last-of-type {
  grid-column: span 3;
  height: 400rpx;
}

/* 两张图片时各占一半 */
.image-grid .image-item:first-child:nth-last-of-type(2),
.image-grid .image-item:nth-child(2):last-of-type {
  grid-column: span 1.5;
  height: 300rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.65);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

.add-image-btn {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  transition: all 0.3s;
}

.add-image-btn:active {
  background: #F0F0F0;
}

.add-icon {
  font-size: 52rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

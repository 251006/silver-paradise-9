/* pages/qa/ask.wxss */
.ask-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.ask-header {
  margin-bottom: 24rpx;
}

.ask-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.ask-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 14rpx;
}

.ask-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.form-group {
  margin-bottom: 18rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.count-text {
  font-size: 22rpx;
  color: #AAAAAA;
}

.required {
  color: #FF4D4F;
}

.form-input {
  height: 96rpx;
  font-size: 32rpx;
}

.form-textarea {
  min-height: 240rpx;
  font-size: 32rpx;
}

.submit-btn {
  margin-top: 36rpx;
}

.submit-btn[disabled] {
  background: #CCCCCC !important;
  opacity: 0.6;
}

/* 图片上传区样式 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F9F9F9;
}

.add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

/* pages/qa/index.wxss */
.qa-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.qa-header {
  margin-bottom: 32rpx;
}

.qa-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.qa-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

.qa-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.qa-card:active {
  background: #FAFAFA;
}

.qa-card-top {
  margin-bottom: 12rpx;
}

.qa-question-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.qa-question-desc {
  margin-bottom: 16rpx;
}

.qa-question-desc text {
  font-size: 28rpx;
  color: #999999;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.qa-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.qa-author {
  font-size: 24rpx;
  color: #CCCCCC;
}

.qa-answer-count {
  display: flex;
  align-items: center;
}

.qa-answer-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.qa-answer-num {
  font-size: 24rpx;
  color: #E8713A;
  font-weight: 500;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8713A, #F5A623);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(232, 113, 58, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

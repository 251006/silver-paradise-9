/* pages/qa/index.wxss */
.qa-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.qa-header {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.qa-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.qa-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.qa-search-box {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.qa-search-input {
  flex: 1;
  font-size: 28rpx;
}

.qa-search-btn,
.qa-clear {
  font-size: 24rpx;
  color: #E8713A;
  font-weight: 500;
}

.qa-tabs {
  display: flex;
  gap: 12rpx;
}

.qa-tab {
  flex: 1;
  text-align: center;
  height: 66rpx;
  line-height: 66rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666666;
}

.qa-tab-active {
  background: #FFF0E6;
  color: #E8713A;
  font-weight: 600;
}

.qa-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
}

.qa-card:active {
  background: #FAFAFA;
}

.qa-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.qa-author-wrap {
  display: flex;
  align-items: center;
}

.qa-author-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F3F3F3;
  flex-shrink: 0;
}

.qa-author-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 24rpx;
}

.qa-author-meta {
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
}

.qa-author-name {
  font-size: 26rpx;
  color: #333333;
}

.qa-time {
  font-size: 22rpx;
  color: #AAAAAA;
}

.qa-follow-btn {
  min-width: 120rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #FFF0E6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #E8713A;
}

.qa-followed {
  background: #F5F5F5;
  color: #999999;
}

.qa-card-top {
  margin-bottom: 12rpx;
}

.qa-question-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.qa-question-desc {
  margin-bottom: 14rpx;
}

.qa-question-desc {
  display: block;
  font-size: 28rpx;
  color: #888888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.qa-risk-banner {
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF7E8;
  border: 1rpx solid #F4D18A;
}

.qa-risk-label {
  display: inline-block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #9A5B00;
}

.qa-risk-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A5A00;
}

.qa-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.qa-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.qa-tag-hot {
  background: #FFF4EC;
  color: #E8713A;
}

.qa-tag-wait {
  background: #EFF8FF;
  color: #2B8CF0;
}

.qa-card-bottom {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 24rpx;
  color: #999999;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8713A, #F5A623);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(232, 113, 58, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

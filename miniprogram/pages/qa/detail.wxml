<view class="detail-page">
  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{question}}">
    <view class="question-card card">
      <view class="question-head">
        <view>
          <text class="question-title">{{question.title}}</text>
          <view class="question-user-meta">
            <text class="meta-author">{{question.authorName}} 提问</text>
            <text class="meta-time">{{question.displayTime}}</text>
          </view>
        </view>
        <view class="question-actions">
          <view class="question-follow {{question.isFollowing ? 'question-followed' : ''}}" bindtap="onToggleFollow">
            <text>{{question.isFollowing ? '已关注' : '+ 关注'}}</text>
          </view>
          <view wx:if="{{canDeleteQuestion}}" class="question-delete" catchtap="deleteQuestion">
            <text>删除</text>
          </view>
        </view>
      </view>

      <text wx:if="{{question.content}}" class="question-content">{{question.content}}</text>

      <!-- 问题图片展示 -->
      <view class="question-images" wx:if="{{question.images && question.images.length > 0}}">
        <view class="image-grid">
          <image
            class="detail-image"
            wx:for="{{question.images}}"
            wx:key="index"
            src="{{item}}"
            mode="aspectFill"
            data-src="{{item}}"
            bindtap="previewImage"
            data-type="question"
          />
        </view>
      </view>

      <view class="question-stats">
        <text>{{question.displayAnswerCount}} 回答</text>
        <text>{{question.displayThanks}} 感谢</text>
        <text>{{question.displayViewCount}} 浏览</text>
        <text>{{question.displayFollowerCount}} 关注</text>
      </view>
    </view>

    <view class="answers-section">
      <view class="answers-head">
        <text class="answers-title">回答 ({{answerCountText}})</text>
        <view class="answer-sort-tabs">
          <view
            wx:for="{{answerSortTabs}}"
            wx:key="key"
            class="answer-sort-tab {{answerSort === item.key ? 'answer-sort-tab-active' : ''}}"
            bindtap="onSwitchAnswerSort"
            data-sort="{{item.key}}"
          >
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{answers.length === 0}}" class="empty-state">
        <text class="empty-state-text">暂无回答，等待长辈分享经验</text>
      </view>

      <view wx:for="{{answers}}" wx:key="_id" class="answer-card card">
        <view class="answer-header">
          <view class="answer-avatar">
            <text class="answer-avatar-text">{{item.authorName[0] || '匿'}}</text>
          </view>
          <view class="answer-author-info">
            <text class="answer-author-name">{{item.authorName}}</text>
            <text class="answer-time">{{item.displayTime}}</text>
          </view>
        </view>
        <text class="answer-content">{{item.content}}</text>

        <!-- 回答图片展示 -->
        <view class="answer-images" wx:if="{{item.images && item.images.length > 0}}">
          <view class="image-grid">
            <image
              class="detail-image"
              wx:for="{{item.images}}"
              wx:key="index"
              src="{{item}}"
              mode="aspectFill"
              data-src="{{item}}"
              data-answer-index="{{index}}"
              bindtap="previewImage"
              data-type="answer"
            />
          </view>
        </view>

        <view class="answer-footer">
          <view
            class="thank-btn {{item.liked ? 'thank-btn-active' : ''}}"
            bindtap="onLikeAnswer"
            data-id="{{item._id}}"
          >
            <text class="thank-icon">🙏</text>
            <text class="thank-text">{{item.liked ? '已感谢' : '感谢'}} ({{item.likes || 0}})</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{role === 'elder'}}" class="answer-input-section">
      <view class="answer-input-header">
        <text class="answer-input-title">分享您的经验</text>
        <text class="answer-input-count">{{answerContent.length}}/1000</text>
      </view>
      <textarea
        class="answer-textarea"
        placeholder="用您的人生经验来回答这个问题吧..."
        placeholder-style="color: #CCCCCC; font-size: 32rpx;"
        value="{{answerContent}}"
        bindinput="onAnswerInput"
        maxlength="1000"
        auto-height
      />
      <view class="answer-input-actions">
        <button
          class="submit-answer-btn btn btn-primary"
          bindtap="submitAnswer"
          disabled="{{submitting || !canSubmitAnswer}}"
        >
          {{submitting ? '提交中...' : '提交回答'}}
        </button>
      </view>
    </view>
  </block>
</view>

<view class="ask-page">
  <view class="ask-header card">
    <text class="ask-title">向长辈提问</text>
    <text class="ask-subtitle">写清场景和困惑，更容易获得高质量回答</text>
    <view class="ask-tips">
      <text>· 标题尽量具体，避免“怎么办”这类模糊描述</text>
      <text>· 描述你的背景信息，回答会更有针对性</text>
    </view>
  </view>

  <view class="form-group card">
    <view class="form-label-row">
      <text class="form-label">问题标题 <text class="required">*</text></text>
      <text class="count-text">{{titleCount}}/50</text>
    </view>
    <input
      class="form-input input-field"
      placeholder="例如：如何和父母沟通职业选择分歧？"
      maxlength="50"
      value="{{title}}"
      bindinput="onTitleInput"
    />
  </view>

  <view class="form-group card">
    <view class="form-label-row">
      <text class="form-label">问题详情（选填）</text>
      <text class="count-text">{{contentCount}}/500</text>
    </view>
    <textarea
      class="form-textarea textarea-field"
      placeholder="补充描述问题的背景和具体情况..."
      placeholder-style="color: #CCCCCC;"
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
      auto-height
    />
  </view>

  <!-- 图片上传区 -->
  <view class="form-group card image-upload-section">
    <view class="form-label-row">
      <text class="form-label">添加图片（选填）</text>
      <text class="count-text">{{images.length}}/{{maxImages}}</text>
    </view>
    <view class="image-grid">
      <!-- 已选图片 -->
      <view
        class="image-item"
        wx:for="{{images}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="previewImage"
      >
        <image class="uploaded-image" src="{{item}}" mode="aspectFill" />
        <view class="delete-btn" data-index="{{index}}" bindtap="deleteImage">
          <text class="delete-icon">×</text>
        </view>
      </view>

      <!-- 添加图片按钮 -->
      <view class="add-image-btn" bindtap="chooseImage" wx:if="{{images.length < maxImages}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <button
    class="submit-btn btn btn-primary btn-block"
    bindtap="submitQuestion"
    disabled="{{submitting || !canSubmit}}"
  >
    {{submitting ? '提交中...' : '发布问题'}}
  </button>
</view>

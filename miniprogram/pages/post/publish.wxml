<view class="publish-page">
  <view class="publish-header">
    <text class="publish-title">写下您的心情或生活感悟</text>
  </view>

  <!-- 内容输入区 -->
  <view class="input-area">
    <textarea
      class="content-textarea"
      placeholder="在这里写下您想分享的内容..."
      placeholder-style="color: #CCCCCC; font-size: 34rpx;"
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
      auto-height
      show-confirm-bar="{{false}}"
    />
    <view class="char-count">
      <text>{{content.length}}/500</text>
    </view>
  </view>

  <!-- 图片上传区 -->
  <view class="image-upload-section">
    <view class="image-grid">
      <!-- 已选图片 -->
      <view
        class="image-item"
        wx:for="{{images}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="previewImage"
      >
        <image class="uploaded-image" src="{{item}}" mode="aspectFill" />
        <view class="delete-btn" data-index="{{index}}" bindtap="deleteImage">
          <text class="delete-icon">×</text>
        </view>
      </view>

      <!-- 添加图片按钮 -->
      <view class="add-image-btn" bindtap="chooseImage" wx:if="{{images.length < maxImages}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
    <view class="image-tip">最多可上传{{maxImages}}张图片</view>
  </view>

  <!-- 发布按钮 -->
  <button
    class="submit-btn btn btn-primary btn-block {{canSubmit && !submitting ? 'submit-btn-enabled' : ''}}"
    bindtap="submitPost"
    disabled="{{submitting || !canSubmit}}"
  >
    {{submitting ? '发布中...' : '发布动态'}}
  </button>
</view>

/* pages/post/detail.wxss */
.post-detail-page {
  min-height: 100vh;
  background: #F7F7F8;
  padding: 0 0 180rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.post-card,
.comment-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 26, 31, 0.06);
}

.post-card {
  margin: -16rpx 20rpx 0;
  padding: 28rpx;
  position: relative;
  z-index: 2;
}

.post-hero {
  width: 100%;
  position: relative;
}

.hero-swiper {
  width: 100%;
  height: 760rpx;
  background: #EDEDF0;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-count {
  position: absolute;
  right: 20rpx;
  bottom: 24rpx;
  min-width: 76rpx;
  height: 44rpx;
  border-radius: 22rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 22rpx;
}

.post-head,
.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-row,
.comment-head {
  display: flex;
  align-items: center;
}

.author-avatar,
.comment-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #E8E9ED;
  flex-shrink: 0;
}

.author-avatar-fallback,
.comment-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5E616A;
  font-size: 28rpx;
  font-weight: 600;
}

.author-meta,
.comment-meta {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.author-name,
.comment-author {
  font-size: 30rpx;
  font-weight: 600;
  color: #191A1F;
}

.post-time,
.comment-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8F939E;
}

.post-content {
  display: block;
  margin-top: 22rpx;
  font-size: 31rpx;
  line-height: 1.78;
  color: #2B2E36;
  white-space: pre-wrap;
}

.risk-banner {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF7E8;
  border: 1rpx solid #F4D18A;
}

.risk-banner-comment {
  margin-top: 12rpx;
}

.risk-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #9A5B00;
  font-weight: 600;
}

.risk-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A5A00;
}

.post-stats {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F1F4;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stat-btn,
.stat-chip {
  height: 62rpx;
  border-radius: 31rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F5F9;
  color: #5C6270;
  font-size: 26rpx;
}

.stat-btn-active {
  background: #FFE9EF;
  color: #E4456F;
}

.stat-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.comments-section {
  margin: 24rpx 20rpx 0;
}

.section-head {
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  color: #191A1F;
  font-weight: 600;
}

.comment-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.comment-content {
  display: block;
  margin-top: 14rpx;
  padding-left: 92rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #363A44;
  white-space: pre-wrap;
}

.comment-editor {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.comment-input {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  background: #F4F6FA;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2A2D35;
}

.comment-submit {
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  border: none;
  background: linear-gradient(135deg, #FF4D6D, #FF7A4E);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 0;
}

.comment-submit::after {
  border: none;
}

.comment-submit[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
}

.loading-box,
.empty-box {
  padding: 120rpx 24rpx;
  text-align: center;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #AA9A91;
}

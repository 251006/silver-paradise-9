/* pages/post/publish.wxss */
.publish-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.publish-header {
  margin-bottom: 32rpx;
}

.publish-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.input-area {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  font-size: 34rpx;
  color: #333333;
  line-height: 1.8;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 16rpx;
}

.char-count text {
  font-size: 24rpx;
  color: #CCCCCC;
}

.submit-btn {
  margin-top: 20rpx;
}

.submit-btn-enabled {
  background: linear-gradient(135deg, #E8713A, #F5A623) !important;
  color: #FFFFFF !important;
  opacity: 1 !important;
}

.submit-btn[disabled] {
  background: #CCCCCC !important;
  opacity: 0.6;
}

/* 图片上传区样式 */
.image-upload-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.image-item {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F5F5;
}

/* 只有一张图片时显示大图 */
.image-grid .image-item:first-child:last-of-type {
  grid-column: span 3;
  height: 400rpx;
}

/* 两张图片时各占一半 */
.image-grid .image-item:first-child:nth-last-of-type(2),
.image-grid .image-item:nth-child(2):last-of-type {
  grid-column: span 1.5;
  height: 300rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.65);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

.add-image-btn {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  transition: all 0.3s;
}

.add-image-btn:active {
  background: #F0F0F0;
}

.add-icon {
  font-size: 52rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

.image-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
}

/* pages/post/publish.wxss */
.publish-page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.publish-header {
  margin-bottom: 32rpx;
}

.publish-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.input-area {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  font-size: 34rpx;
  color: #333333;
  line-height: 1.8;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 16rpx;
}

.char-count text {
  font-size: 24rpx;
  color: #CCCCCC;
}

.submit-btn {
  margin-top: 20rpx;
}

.submit-btn-enabled {
  background: linear-gradient(135deg, #E8713A, #F5A623) !important;
  color: #FFFFFF !important;
  opacity: 1 !important;
}

.submit-btn[disabled] {
  background: #CCCCCC !important;
  opacity: 0.6;
}

/* 图片上传区样式 */
.image-upload-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F9F9F9;
}

.add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

.image-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
}

<!-- pages/community/index.wxml -->
<wxs src="../../utils/timeUtils.wxs" module="timeUtils" />

<view class="discover-page">
  <view class="hero-header">
    <view class="hero-top-row">
      <view class="nav-left">
        <view class="avatar-dot">
          <image wx:if="{{currentUserAvatar}}" src="{{currentUserAvatar}}" mode="aspectFill" class="avatar-dot-image" />
          <text wx:else class="avatar-dot-fallback">{{currentUserNameShort || '银'}}</text>
        </view>
        <text class="update-badge">更新</text>
      </view>
      <view class="nav-center">
        <text class="nav-tab {{activeTab === 0 ? 'is-active' : ''}}" data-index="0" bindtap="onTabChange">发现</text>
        <text class="nav-tab {{activeTab === 1 ? 'is-active' : ''}}" data-index="1" bindtap="onTabChange">提问</text>
      </view>
      <view class="nav-right">
        <text class="search-icon">⌕</text>
      </view>
    </view>
  </view>

  <view class="feed-wrap" wx:if="{{activeTab === 0}}">
    <view class="masonry">
      <view class="masonry-col">
        <view class="note-card" wx:for="{{postsLeft}}" wx:key="_id" bindtap="goPostDetail" data-id="{{item._id}}">
          <image
            wx:if="{{item.coverImage}}"
            class="note-cover post-note-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
            data-src="{{item.coverImage}}"
            catchtap="previewPostImage"
          />
          <view wx:else class="note-cover post-note-cover post-cover-fallback">
            <view class="post-cover-fallback-text">{{item.coverFallbackText}}</view>
          </view>
          <view class="note-body">
            <text class="note-title">{{item.previewTitle}}</text>
            <view class="note-meta">
              <view class="author-chip">
                <image wx:if="{{item.authorAvatarUrl}}" class="chip-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" />
                <view wx:else class="chip-avatar chip-avatar-fallback">
                  <text>{{item.authorInitial}}</text>
                </view>
                <text class="chip-name">{{item.authorName || '匿名长辈'}}</text>
              </view>
              <view class="note-actions">
                <view class="like-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" catchtap="onLikePost">
                  <text class="like-icon">{{item.liked ? '♥' : '♡'}}</text>
                  <text class="like-count">{{item.likes || 0}}</text>
                </view>
                <view wx:if="{{item.canDelete}}" class="more-btn" catchtap="showPostMenu" data-id="{{item._id}}">
                  <text>⋯</text>
                </view>
              </view>
            </view>
            <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
          </view>
        </view>
      </view>

      <view class="masonry-col">
        <view class="note-card" wx:for="{{postsRight}}" wx:key="_id" bindtap="goPostDetail" data-id="{{item._id}}">
          <image
            wx:if="{{item.coverImage}}"
            class="note-cover post-note-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
            data-src="{{item.coverImage}}"
            catchtap="previewPostImage"
          />
          <view wx:else class="note-cover post-note-cover post-cover-fallback">
            <view class="post-cover-fallback-text">{{item.coverFallbackText}}</view>
          </view>
          <view class="note-body">
            <text class="note-title">{{item.previewTitle}}</text>
            <view class="note-meta">
              <view class="author-chip">
                <image wx:if="{{item.authorAvatarUrl}}" class="chip-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" />
                <view wx:else class="chip-avatar chip-avatar-fallback">
                  <text>{{item.authorInitial}}</text>
                </view>
                <text class="chip-name">{{item.authorName || '匿名长辈'}}</text>
              </view>
              <view class="note-actions">
                <view class="like-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" catchtap="onLikePost">
                  <text class="like-icon">{{item.liked ? '♥' : '♡'}}</text>
                  <text class="like-count">{{item.likes || 0}}</text>
                </view>
                <view wx:if="{{item.canDelete}}" class="more-btn" catchtap="showPostMenu" data-id="{{item._id}}">
                  <text>⋯</text>
                </view>
              </view>
            </view>
            <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{!postsLoading && posts.length === 0}}">
      <text>暂无动态，期待长辈们的分享</text>
    </view>
    <view class="loading-tip" wx:if="{{postsLoading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-tip" wx:if="{{!postsHasMore && posts.length > 0}}">
      <text>已经到底了</text>
    </view>
  </view>

  <view class="feed-wrap" wx:if="{{activeTab === 1}}">
    <view class="masonry">
      <view class="masonry-col">
        <view class="question-card" wx:for="{{questionsLeft}}" wx:key="_id" bindtap="goQuestionDetail" data-id="{{item._id}}">
          <image
            wx:if="{{item.coverImage}}"
            class="note-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
            data-src="{{item.coverImage}}"
            catchtap="previewQuestionImage"
          />
          <view class="note-body">
            <text class="note-title">{{item.title}}</text>
            <text wx:if="{{item.content}}" class="note-subtitle">{{item.content}}</text>
            <view wx:if="{{item.auditStatus === 'warned' && item.riskWarning}}" class="risk-banner">
              <text class="risk-banner-label">风险提示</text>
              <text class="risk-banner-text">{{item.riskWarning}}</text>
            </view>
            <view class="qa-metrics">
              <text>{{item.answerCount || 0}} 回答</text>
              <text>{{item.viewCount || 0}} 浏览</text>
            </view>
            <view class="author-chip qa-author">
              <text class="chip-name">{{item.authorName || '匿名用户'}}</text>
              <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="masonry-col">
        <view class="question-card" wx:for="{{questionsRight}}" wx:key="_id" bindtap="goQuestionDetail" data-id="{{item._id}}">
          <image
            wx:if="{{item.coverImage}}"
            class="note-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
            data-src="{{item.coverImage}}"
            catchtap="previewQuestionImage"
          />
          <view class="note-body">
            <text class="note-title">{{item.title}}</text>
            <text wx:if="{{item.content}}" class="note-subtitle">{{item.content}}</text>
            <view wx:if="{{item.auditStatus === 'warned' && item.riskWarning}}" class="risk-banner">
              <text class="risk-banner-label">风险提示</text>
              <text class="risk-banner-text">{{item.riskWarning}}</text>
            </view>
            <view class="qa-metrics">
              <text>{{item.answerCount || 0}} 回答</text>
              <text>{{item.viewCount || 0}} 浏览</text>
            </view>
            <view class="author-chip qa-author">
              <text class="chip-name">{{item.authorName || '匿名用户'}}</text>
              <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{!questionsLoading && questions.length === 0}}">
      <text>还没有提问，来发起第一个问题</text>
    </view>
    <view class="loading-tip" wx:if="{{questionsLoading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-tip" wx:if="{{!questionsHasMore && questions.length > 0}}">
      <text>已经到底了</text>
    </view>
  </view>
</view>

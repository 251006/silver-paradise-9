/* pages/community/index.wxss */
.discover-page {
  min-height: 100vh;
  background: #FFF8F0;
  color: #333333;
  padding-bottom: 190rpx;
}

.hero-header {
  position: sticky;
  top: 0;
  z-index: 110;
  padding: 24rpx 24rpx 18rpx;
  background: linear-gradient(180deg, #FFF1E8 0%, rgba(255, 248, 240, 0.96) 80%);
  backdrop-filter: blur(8px);
}

.hero-top-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left,
.nav-right {
  width: 130rpx;
  display: flex;
  align-items: center;
}

.nav-right {
  justify-content: flex-end;
}

.avatar-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 1rpx solid rgba(232, 113, 58, 0.16);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-dot-image {
  width: 100%;
  height: 100%;
}

.avatar-dot-fallback {
  font-size: 24rpx;
  color: #E8713A;
}

.update-badge {
  margin-left: 10rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 22rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #f0384e;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 46rpx;
}

.nav-tab {
  font-size: 42rpx;
  color: #9A8F88;
  font-weight: 500;
  position: relative;
}

.nav-tab.is-active {
  color: #2F241F;
  font-weight: 700;
}

.nav-tab.is-active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 52rpx;
  height: 6rpx;
  margin-left: -26rpx;
  border-radius: 4rpx;
  background: #f53f5a;
}

.search-icon {
  font-size: 42rpx;
  color: #5B4B42;
}

.feed-wrap {
  padding: 18rpx;
}

.masonry {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.masonry-col {
  flex: 1;
}

.note-card,
.question-card {
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(232, 113, 58, 0.08);
  box-shadow: 0 6rpx 20rpx rgba(171, 106, 61, 0.08);
}

.note-card {
  min-height: 520rpx;
}

.note-cover {
  width: 100%;
  height: 248rpx;
  background: #F4EEE7;
}

.post-note-cover {
  height: 338rpx;
}

.post-cover-fallback {
  position: relative;
  background: linear-gradient(145deg, #FFFDF9 0%, #FFF5E8 58%, #FCECD8 100%);
}

.post-cover-fallback-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 78%;
  font-family: "STKaiti", "KaiTi", "FangSong", serif;
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #6F4B2A;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  text-align: center;
  max-height: 4.35em;
  overflow: hidden;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
}

.note-body {
  padding: 16rpx 16rpx 14rpx;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
}

.note-title {
  font-size: 29rpx;
  line-height: 1.5;
  color: #2F241F;
  font-weight: 600;
  min-height: 86rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.note-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #756860;
  font-size: 25rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.risk-banner {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 183, 43, 0.14);
  border: 1rpx solid rgba(255, 183, 43, 0.3);
}

.risk-banner-label {
  display: block;
  font-size: 20rpx;
  color: #8F5200;
  margin-bottom: 4rpx;
  font-weight: 600;
}

.risk-banner-text {
  font-size: 22rpx;
  color: #6A3C00;
  line-height: 1.45;
}

.note-meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-chip {
  display: flex;
  align-items: center;
  min-width: 0;
}

.chip-avatar {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #F6D9C8;
}

.chip-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A512F;
  font-size: 20rpx;
}

.chip-name {
  margin-left: 8rpx;
  max-width: 180rpx;
  font-size: 22rpx;
  color: #5D5049;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-btn {
  min-width: 90rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #FFF4EC;
}

.like-btn.liked {
  background: #FFE7EA;
}

.like-icon {
  font-size: 24rpx;
  color: #f76f84;
}

.like-count {
  font-size: 22rpx;
  color: #7C5B4D;
}

.more-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8C7A71;
  background: #F8F1EA;
}

.note-time {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 21rpx;
  color: #AA9A91;
}

.qa-metrics {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.qa-metrics text {
  font-size: 22rpx;
  color: #8A7C74;
  background: #F8F1EA;
  border-radius: 18rpx;
  padding: 4rpx 12rpx;
}

.qa-author {
  margin-top: 14rpx;
  justify-content: space-between;
}

.empty-tip,
.loading-tip {
  padding: 80rpx 0;
  text-align: center;
}

.empty-tip text,
.loading-tip text {
  font-size: 26rpx;
  color: #AA9A91;
}

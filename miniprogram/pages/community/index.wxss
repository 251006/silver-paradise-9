/* pages/community/index.wxss - 社区页样式 */
.container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 120rpx;
}

/* Tab栏样式 */
.tab-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 100rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  position: relative;
}

.tab-text {
  font-size: 32rpx;
  color: #666666;
  font-weight: 500;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #E8713A;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #E8713A, #F5A623);
  border-radius: 3rpx;
}

/* 内容区域 */
.content {
  padding: 24rpx;
}

/* ========== 动态列表样式 ========== */
.post-list {
  padding-bottom: 20rpx;
}

.post-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 动态头部 */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8713A, #F5A623);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.post-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.post-menu {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-left: 12rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* 动态内容 */
.post-content {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 20rpx;
  word-break: break-word;
}

.risk-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF7E8;
  border: 1rpx solid #F6D28B;
}

.risk-banner-question {
  margin-bottom: 16rpx;
}

.risk-banner-label {
  display: inline-block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #9A5B00;
  font-weight: 600;
}

.risk-banner-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A5A00;
}

/* 动态图片 */
.post-images {
  margin-bottom: 20rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.post-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 只有一张图片时显示大图 */
.image-grid .post-image:first-child:last-child {
  grid-column: span 3;
  height: 400rpx;
}

/* 两张图片时各占一半 */
.image-grid .post-image:first-child:nth-last-child(2),
.image-grid .post-image:nth-child(2):last-child {
  grid-column: span 1.5;
  height: 300rpx;
}

/* 动态底部 */
.post-footer {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.like-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #FFF8F0;
  transition: all 0.3s;
}

.like-btn:active {
  background: #FFE8D0;
}

.like-btn.liked {
  background: #FFE8D0;
}

.like-btn .icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.like-btn .like-count {
  font-size: 28rpx;
  color: #E8713A;
  font-weight: 500;
}

/* ========== 问答列表样式 ========== */
.question-list {
  padding-bottom: 20rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.question-card:active {
  background: #FAFAFA;
}

/* 问题头部 */
.question-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.question-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  margin-right: 16rpx;
}

.answer-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #FFF0E6;
}

.answer-badge text {
  font-size: 24rpx;
  color: #E8713A;
  font-weight: 500;
}

/* 问题内容 */
.question-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 问题图片 */
.question-images {
  margin-bottom: 16rpx;
}

.question-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 只有一张图片时显示大图 */
.question-images .image-grid .question-image:first-child:last-child {
  grid-column: span 3;
  height: 400rpx;
}

/* 问题底部 */
.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.question-footer .author-name {
  font-size: 26rpx;
  color: #666666;
}

.question-time {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* ========== 浮动按钮 ========== */
.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8713A, #F5A623);
  box-shadow: 0 8rpx 24rpx rgba(232, 113, 58, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  z-index: 99;
}

.float-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.float-btn::after {
  border: none;
}

.float-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

/* ========== 空状态和加载状态 ========== */
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-tip text,
.loading-tip text {
  font-size: 28rpx;
  color: #AAAAAA;
}

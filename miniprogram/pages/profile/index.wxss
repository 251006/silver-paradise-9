.profile-page {
  min-height: 100vh;
  background: #f6f2ea;
  padding-bottom: 48rpx;
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(180deg, #857864 0%, #c8bba4 100%);
}

.header-action {
  position: relative;
  z-index: 2;
  margin-left: auto;
  margin-right: 28rpx;
  width: fit-content;
  padding: 18rpx 22rpx;
  top: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff7ec;
}

.header-action-icon {
  font-size: 24rpx;
}

.header-action-text {
  font-size: 24rpx;
}

.user-header {
  position: relative;
  z-index: 1;
  padding: 84rpx 32rpx 0;
  display: flex;
  align-items: center;
}

.avatar-container {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.75);
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(53, 42, 27, 0.16);
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
  color: #fffaf2;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-name {
  font-size: 48rpx;
  font-weight: 700;
}

.role-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.user-id {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 248, 238, 0.88);
}

.user-bio {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 248, 238, 0.76);
  line-height: 1.6;
}

.stats-section {
  position: relative;
  z-index: 1;
  margin: 28rpx 24rpx 0;
  padding: 26rpx 0;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 36rpx rgba(83, 65, 37, 0.08);
  display: flex;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-item-clickable {
  position: relative;
}

.stat-item-clickable:active {
  opacity: 0.75;
}

.stat-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #2d2419;
}

.stat-label {
  font-size: 24rpx;
  color: #8f7d68;
}

.function-cards {
  position: relative;
  z-index: 1;
  margin: 20rpx 24rpx 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.function-card {
  background: linear-gradient(180deg, #fffefb 0%, #f5eee4 100%);
  border-radius: 24rpx;
  padding: 26rpx 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(85, 67, 39, 0.05);
}

.function-card-single {
  grid-column: 1 / span 2;
}

.function-icon {
  font-size: 42rpx;
}

.function-info {
  flex: 1;
}

.function-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2f271d;
}

.function-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b7a66;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 28rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #241e16;
}

.section-count {
  font-size: 24rpx;
  color: #8f7d68;
}

.loading-box,
.empty-state {
  margin: 0 24rpx;
  padding: 80rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  text-align: center;
}

.loading-text,
.empty-state-text {
  font-size: 28rpx;
  color: #978570;
}

.question-card {
  margin: 0 24rpx 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(85, 67, 39, 0.06);
}

.question-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.7;
  color: #2d2419;
}

.question-title {
  font-weight: 700;
}

.question-content {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #655744;
}

.question-meta-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e7d9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
}

.question-meta {
  font-size: 24rpx;
  color: #9a8974;
}

.masonry-wrap {
  padding: 0 18rpx;
}

.masonry {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.masonry-col {
  flex: 1;
}

.my-note-card {
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(232, 113, 58, 0.08);
  box-shadow: 0 6rpx 20rpx rgba(171, 106, 61, 0.08);
  min-height: 520rpx;
}

.note-cover {
  width: 100%;
  height: 248rpx;
  background: #F4EEE7;
}

.post-note-cover {
  height: 338rpx;
}

.post-cover-fallback {
  position: relative;
  background: linear-gradient(145deg, #FFFDF9 0%, #FFF5E8 58%, #FCECD8 100%);
}

.post-cover-fallback-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 78%;
  font-family: "STKaiti", "KaiTi", "FangSong", serif;
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #6F4B2A;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  text-align: center;
  max-height: 4.35em;
  overflow: hidden;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
}

.note-body {
  padding: 16rpx 16rpx 14rpx;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
}

.note-title {
  font-size: 29rpx;
  line-height: 1.5;
  color: #2F241F;
  font-weight: 600;
  min-height: 86rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.note-meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-chip {
  display: flex;
  align-items: center;
  min-width: 0;
}

.chip-avatar {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #F6D9C8;
}

.chip-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A512F;
  font-size: 20rpx;
}

.chip-name {
  margin-left: 8rpx;
  max-width: 180rpx;
  font-size: 22rpx;
  color: #5D5049;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-btn {
  min-width: 90rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #FFF4EC;
}

.like-btn.liked {
  background: #FFE7EA;
}

.like-icon {
  font-size: 24rpx;
  color: #f76f84;
}

.like-count {
  font-size: 22rpx;
  color: #7C5B4D;
}

.more-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8C7A71;
  background: #F8F1EA;
}

.memoir-action-row {
  margin-top: 10rpx;
  display: flex;
}

.memoir-btn {
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #efe4d1;
}

.memoir-btn-text {
  font-size: 22rpx;
  color: #6f624f;
}

.note-time {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 21rpx;
  color: #AA9A91;
}
.profile-page {
  min-height: 100vh;
  background: #f6f2ea;
  padding-bottom: 48rpx;
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(180deg, #857864 0%, #c8bba4 100%);
}

.header-action {
  position: relative;
  z-index: 2;
  margin-left: auto;
  margin-right: 28rpx;
  width: fit-content;
  padding: 18rpx 22rpx;
  top: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff7ec;
}

.header-action-icon {
  font-size: 24rpx;
}

.header-action-text {
  font-size: 24rpx;
}

.user-header {
  position: relative;
  z-index: 1;
  padding: 84rpx 32rpx 0;
  display: flex;
  align-items: center;
}

.avatar-container {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.75);
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(53, 42, 27, 0.16);
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
  color: #fffaf2;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-name {
  font-size: 48rpx;
  font-weight: 700;
}

.role-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.user-id {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 248, 238, 0.88);
}

.user-bio {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 248, 238, 0.76);
  line-height: 1.6;
}

.stats-section {
  position: relative;
  z-index: 1;
  margin: 28rpx 24rpx 0;
  padding: 26rpx 0;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 36rpx rgba(83, 65, 37, 0.08);
  display: flex;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-item-clickable {
  position: relative;
}

.stat-item-clickable:active {
  opacity: 0.75;
}

.stat-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #2d2419;
}

.stat-label {
  font-size: 24rpx;
  color: #8f7d68;
}

.function-cards {
  position: relative;
  z-index: 1;
  margin: 20rpx 24rpx 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.function-card {
  background: linear-gradient(180deg, #fffefb 0%, #f5eee4 100%);
  border-radius: 24rpx;
  padding: 26rpx 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(85, 67, 39, 0.05);
}

.function-card-single {
  grid-column: 1 / span 2;
}

.function-icon {
  font-size: 42rpx;
}

.function-info {
  flex: 1;
}

.function-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2f271d;
}

.function-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b7a66;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 28rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #241e16;
}

.section-count {
  font-size: 24rpx;
  color: #8f7d68;
}

.loading-box,
.empty-state {
  margin: 0 24rpx;
  padding: 80rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  text-align: center;
}

.loading-text,
.empty-state-text {
  font-size: 28rpx;
  color: #978570;
}

.post-card,
.question-card {
  margin: 0 24rpx 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(85, 67, 39, 0.06);
}

.post-content,
.question-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.7;
  color: #2d2419;
}

.question-title {
  font-weight: 700;
}

.question-content {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #655744;
}

.post-footer,
.question-meta-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e7d9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
}

.post-time,
.question-meta {
  font-size: 24rpx;
  color: #9a8974;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-item {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f5ede1;
}

.action-icon,
.action-count,
.action-text {
  font-size: 24rpx;
  color: #6f624f;
}

.memoir-btn {
  background: #efe4d1;
}

.delete-btn {
  background: #f8e2df;
}

.delete-btn .action-text {
  color: #cf4d43;
}
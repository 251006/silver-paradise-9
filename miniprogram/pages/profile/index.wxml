<wxs src="../../utils/timeUtils.wxs" module="timeUtils" />

<view class="profile-page safe-bottom">
  <view class="profile-bg"></view>

  <view class="header-action" bindtap="goMessages">
    <text class="header-action-icon">🔔</text>
    <text class="header-action-text">消息</text>
  </view>

  <view class="user-header">
    <view class="avatar-container" bindtap="goSettings">
      <image
        class="avatar-image"
        src="{{avatarUrl}}"
        mode="aspectFill"
        binderror="onAvatarError"
      ></image>
    </view>

    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{nickname}}</text>
        <view class="role-badge">
          <text>{{role === 'elder' ? '长辈' : '年轻人'}}</text>
        </view>
      </view>
      <text class="user-id">银龄号：{{openid.length > 12 ? openid.substring(0, 12) + '...' : openid || '未知'}}</text>
      <text class="user-bio">{{role === 'elder' ? '把生活写成温柔的笔记。' : '把问题抛向社区，等经验落下来。'}}</text>
    </view>
  </view>

  <view class="stats-section">
    <view class="stat-item stat-item-clickable" bindtap="goFollowingList">
      <text class="stat-number">{{followingCount}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-item stat-item-clickable" bindtap="goFollowerList">
      <text class="stat-number">{{followerCount}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{likeCount}}</text>
      <text class="stat-label">获赞</text>
    </view>
  </view>

  <view class="function-cards">
    <block wx:if="{{role === 'elder'}}">
      <view class="function-card" bindtap="goPublish">
        <view class="function-icon">✏️</view>
        <view class="function-info">
          <text class="function-title">发布动态</text>
          <text class="function-desc">把最近的生活分享给大家</text>
        </view>
      </view>
      <view class="function-card" bindtap="goMemoir">
        <view class="function-icon">📝</view>
        <view class="function-info">
          <text class="function-title">我的回忆录</text>
          <text class="function-desc">继续整理值得留下的片段</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="function-card function-card-single" bindtap="goAsk">
        <view class="function-icon">❓</view>
        <view class="function-info">
          <text class="function-title">我要提问</text>
          <text class="function-desc">向长辈请教，收集不同的人生答案</text>
        </view>
      </view>
    </block>
  </view>

  <view class="section-header">
    <text class="section-title">{{role === 'elder' ? '我的动态' : '我的提问'}}</text>
    <text class="section-count">{{role === 'elder' ? postCount : questionCount}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{role === 'elder'}}">
    <view wx:if="{{posts.length === 0}}" class="empty-state">
      <text class="empty-state-text">还没有发布动态，去记录今天的故事吧</text>
    </view>

    <block wx:else>
      <view class="masonry-wrap">
        <view class="masonry">
          <view class="masonry-col">
            <view class="my-note-card" wx:for="{{postsLeft}}" wx:key="_id" bindtap="goPostDetail" data-id="{{item._id}}">
              <image
                wx:if="{{item.coverImage}}"
                class="note-cover post-note-cover"
                src="{{item.coverImage}}"
                mode="aspectFill"
                data-src="{{item.coverImage}}"
                catchtap="previewPostImage"
              />
              <view wx:else class="note-cover post-note-cover post-cover-fallback">
                <view class="post-cover-fallback-text">{{item.coverFallbackText}}</view>
              </view>
              <view class="note-body">
                <text class="note-title">{{item.previewTitle}}</text>
                <view class="note-meta">
                  <view class="author-chip">
                    <image wx:if="{{item.authorAvatarUrl}}" class="chip-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" />
                    <view wx:else class="chip-avatar chip-avatar-fallback">
                      <text>{{item.authorInitial}}</text>
                    </view>
                    <text class="chip-name">{{item.authorName || nickname}}</text>
                  </view>
                  <view class="note-actions">
                    <view class="like-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" catchtap="onLikePost">
                      <text class="like-icon">{{item.liked ? '♥' : '♡'}}</text>
                      <text class="like-count">{{item.likes || 0}}</text>
                    </view>
                    <view class="more-btn" catchtap="deletePost" data-id="{{item._id}}">
                      <text>⋯</text>
                    </view>
                  </view>
                </view>
                <view class="memoir-action-row">
                  <view class="memoir-btn" catchtap="addToMemoir" data-id="{{item._id}}">
                    <text class="memoir-btn-text">加入回忆录</text>
                  </view>
                </view>
                <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
              </view>
            </view>
          </view>

          <view class="masonry-col">
            <view class="my-note-card" wx:for="{{postsRight}}" wx:key="_id" bindtap="goPostDetail" data-id="{{item._id}}">
              <image
                wx:if="{{item.coverImage}}"
                class="note-cover post-note-cover"
                src="{{item.coverImage}}"
                mode="aspectFill"
                data-src="{{item.coverImage}}"
                catchtap="previewPostImage"
              />
              <view wx:else class="note-cover post-note-cover post-cover-fallback">
                <view class="post-cover-fallback-text">{{item.coverFallbackText}}</view>
              </view>
              <view class="note-body">
                <text class="note-title">{{item.previewTitle}}</text>
                <view class="note-meta">
                  <view class="author-chip">
                    <image wx:if="{{item.authorAvatarUrl}}" class="chip-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" />
                    <view wx:else class="chip-avatar chip-avatar-fallback">
                      <text>{{item.authorInitial}}</text>
                    </view>
                    <text class="chip-name">{{item.authorName || nickname}}</text>
                  </view>
                  <view class="note-actions">
                    <view class="like-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" catchtap="onLikePost">
                      <text class="like-icon">{{item.liked ? '♥' : '♡'}}</text>
                      <text class="like-count">{{item.likes || 0}}</text>
                    </view>
                    <view class="more-btn" catchtap="deletePost" data-id="{{item._id}}">
                      <text>⋯</text>
                    </view>
                  </view>
                </view>
                <view class="memoir-action-row">
                  <view class="memoir-btn" catchtap="addToMemoir" data-id="{{item._id}}">
                    <text class="memoir-btn-text">加入回忆录</text>
                  </view>
                </view>
                <text class="note-time">{{timeUtils.formatTime(item.createdAt)}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <block wx:else>
    <view wx:if="{{questions.length === 0}}" class="empty-state">
      <text class="empty-state-text">还没有提问，去发起第一个问题吧</text>
    </view>

    <block wx:else>
      <view wx:for="{{questions}}" wx:key="_id" class="question-card" bindtap="goQuestionDetail" data-id="{{item._id}}">
        <text class="question-title">{{item.title}}</text>
        <text wx:if="{{item.content}}" class="question-content">{{item.content}}</text>
        <view class="question-meta-row">
          <text class="question-meta">{{item.answerCount || 0}} 回答</text>
          <text class="question-meta">{{item.viewCount || 0}} 浏览</text>
          <text class="question-meta">{{timeUtils.formatTime(item.createdAt)}}</text>
        </view>
      </view>
    </block>
  </block>
</view>

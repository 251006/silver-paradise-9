/* pages/live-room/index.wxss - 直播间样式 */

.container {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.room-header {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.card-body {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.card-meta {
  font-size: 26rpx;
  color: #999999;
}

.video-stage {
  margin: 24rpx 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1a1a2e, #2d2d44);
  color: #fff;
  padding: 100rpx 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.stage-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.stage-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.stage-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
}

.inline-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.primary-btn {
  flex: 1;
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  flex: 1;
  background: #FFFFFF;
  color: #E74C3C;
  border: 2rpx solid #E74C3C;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

.secondary-btn::after {
  border: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #E74C3C;
}

.danmu-panel {
  height: 400rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.danmu-item {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333333;
  border-bottom: 1rpx solid #F0F0F0;
}

.danmu-item:last-child {
  border-bottom: none;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.text-area {
  width: 100%;
  height: 120rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  background: #FAFAFA;
}

.room-footer {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

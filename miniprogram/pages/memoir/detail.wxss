/* pages/memoir/detail.wxss */
.detail-page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.detail-header {
  margin-bottom: 40rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #F0E6DD;
}

.detail-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.detail-time {
  display: block;
  font-size: 26rpx;
  color: #CCCCCC;
}

.detail-body {
  margin-bottom: 60rpx;
}

.detail-content {
  font-size: 34rpx;
  color: #444444;
  line-height: 2;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
}

.detail-footer {
  padding: 24rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.footer-label {
  font-size: 24rpx;
  color: #E8713A;
}

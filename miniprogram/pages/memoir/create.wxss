/* pages/memoir/create.wxss */
.create-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* ---- 步骤头 ---- */
.step-header {
  margin-bottom: 32rpx;
}

.step-label {
  display: inline-block;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #E8713A;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}

.step-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #333333;
  margin-top: 12rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ---- 选材工具栏 ---- */
.select-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.selected-info {
  font-size: 28rpx;
  color: #E8713A;
  font-weight: 600;
}

.select-all-link {
  font-size: 26rpx;
  color: #E8713A;
  text-decoration: underline;
}

/* ---- 素材分区 ---- */
.material-section {
  margin-bottom: 32rpx;
}

.section-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 16rpx;
}

.material-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #F0E6DD;
  transition: border-color 0.2s, background 0.2s;
}

.material-item.selected {
  border-color: #E8713A;
  background: #FFF8F0;
}

.material-item:active {
  opacity: 0.8;
}

.check-box {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 8rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.check-box.checked {
  background: #E8713A;
  border-color: #E8713A;
  color: #FFFFFF;
  font-size: 28rpx;
}

.material-text {
  flex: 1;
}

.material-content {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.material-time {
  display: block;
  font-size: 22rpx;
  color: #CCCCCC;
}

/* ---- 底部按钮 ---- */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0E6DD;
}

.bottom-actions .btn {
  flex: 1;
}

.manual-btn {
  margin-top: 40rpx;
}

/* ---- 生成中动画 ---- */
.generating-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.generating-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.generating-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.generating-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.generating-dots {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #E8713A;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot1 { animation-delay: 0s; }
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---- 编辑表单 ---- */
.edit-form {
  margin-bottom: 40rpx;
}

.title-input {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.content-textarea {
  font-size: 30rpx;
  line-height: 1.8;
}

.empty-hint {
  font-size: 26rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}
